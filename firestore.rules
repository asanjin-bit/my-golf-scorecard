rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(roundId) { return signed() && request.auth.uid in get(/databases/$(database)/documents/rounds/$(roundId)).data.memberUids; }
  match /rounds/{roundId} {
   // Random twelve-character IDs act as invitation URLs. Do not permit listing all rounds.
   allow get: if signed();
   allow list: if false;
   allow create: if signed()
     && roundId.matches('[A-HJ-NP-Z2-9]{12}')
     && request.resource.data.keys().hasOnly(['creatorUid','memberUids','courseId','pars','createdAt','state'])
     && request.resource.data.creatorUid == request.auth.uid
     && request.resource.data.memberUids == [request.auth.uid]
     && request.resource.data.courseId in ['zagreb','topala','sarajevo']
     && request.resource.data.pars is list && request.resource.data.pars.size() == 18
     && request.resource.data.state == 'open';
   // Joining can only add the requesting user, up to 4 players, without changing other fields.
   allow update: if signed() && resource.data.state == 'open'
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
      && !(request.auth.uid in resource.data.memberUids)
      && request.resource.data.memberUids.size() == resource.data.memberUids.size()+1
      && request.resource.data.memberUids.size() <= 4
      && request.resource.data.memberUids.hasAll(resource.data.memberUids)
      && request.auth.uid in request.resource.data.memberUids;
   allow delete: if false;
   match /players/{uid} {
     allow get,list: if member(roundId);
     allow create: if member(roundId) && request.auth.uid == uid
       && request.resource.data.keys().hasOnly(['name','scores','updatedAt'])
       && request.resource.data.name is string && request.resource.data.name.size() <= 32
       && request.resource.data.scores is list && request.resource.data.scores.size()==18;
     allow update: if member(roundId) && request.auth.uid == uid
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scores','updatedAt'])
       && request.resource.data.scores is list && request.resource.data.scores.size()==18;
     allow delete: if false;
   }
  }
 }
}
